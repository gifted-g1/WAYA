# Waya Mobile Environment Configuration
# Go & Gin Backend API Endpoint (override for staging or local production server)
EXPO_PUBLIC_API_URL=https://api.wayalogistics.africa/v1

# WebSocket Endpoint for Live Telemetry Stream
EXPO_PUBLIC_WS_URL=wss://api.wayalogistics.africa/v1/ws

# Controlled Demo Mode (true enables offline demo simulation; false connects to Go backend)
EXPO_PUBLIC_ENABLE_DEMO_MODE=true

# Google Maps / Mapbox Access Token (Optional: Default uses Waya Vector Tile Engine)
EXPO_PUBLIC_MAP_KEY=pk.waya_demo_live_tiles_nigeria

# Nigerian Payment Gateway Public Keys (Paystack / Flutterwave)
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_waya_paystack_public_key_nigeria
EXPO_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-waya-public-key
